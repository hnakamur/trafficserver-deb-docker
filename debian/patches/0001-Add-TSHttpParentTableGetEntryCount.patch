From 912ebfedc0200ae9898e991f54f59f79a302868e Mon Sep 17 00:00:00 2001
From: Hiroaki Nakamura <hnakamur@gmail.com>
Date: Tue, 8 Sep 2026 21:42:03 +0900
Subject: [PATCH 1/5] Add TSHttpParentTableGetEntryCount

---
 include/ts/ts.h            |  5 +++++
 plugins/lua/ts_lua_http.cc | 17 +++++++++++++++++
 src/api/InkAPI.cc          | 11 +++++++++++
 3 files changed, 33 insertions(+)

diff --git a/include/ts/ts.h b/include/ts/ts.h
index cff3a73b6..9e09c5090 100644
--- a/include/ts/ts.h
+++ b/include/ts/ts.h
@@ -3368,3 +3368,8 @@ std::tuple<int, int> TSLogIntUnmarshal(char **buf, char *dest, int len);
    Helper function to unmarshal an address
 */
 std::tuple<int, int> TSLogAddrUnmarshal(char **buf, char *dest, int len);
+
+/*
+ * Get entry count in parent.config.
+ */
+int TSHttpParentTableGetEntryCount(TSHttpTxn txnp);
diff --git a/plugins/lua/ts_lua_http.cc b/plugins/lua/ts_lua_http.cc
index cac64dc44..065b4f46f 100644
--- a/plugins/lua/ts_lua_http.cc
+++ b/plugins/lua/ts_lua_http.cc
@@ -132,6 +132,8 @@ static int  ts_lua_http_req_transform_get_downstream_watermark_bytes(lua_State *
 static int  ts_lua_http_req_transform_set_downstream_watermark_bytes(lua_State *L);
 static int  ts_lua_http_req_transform_set_upstream_bytes(lua_State *L);
 
+static int ts_lua_http_get_parent_table_entry_count(lua_State *L);
+
 void
 ts_lua_inject_http_api(lua_State *L)
 {
@@ -332,6 +334,9 @@ ts_lua_inject_http_misc_api(lua_State *L)
   lua_pushcfunction(L, ts_lua_http_get_ssn_remote_addr);
   lua_setfield(L, -2, "get_ssn_remote_addr");
 
+  lua_pushcfunction(L, ts_lua_http_get_parent_table_entry_count);
+  lua_setfield(L, -2, "get_parent_table_entry_count");
+
   ts_lua_inject_server_state_variables(L);
 }
 
@@ -1263,3 +1268,15 @@ ts_lua_http_req_transform_set_upstream_bytes(lua_State *L)
 {
   return ts_lua_http_resp_transform_set_downstream_bytes(L);
 }
+
+static int
+ts_lua_http_get_parent_table_entry_count(lua_State *L)
+{
+  ts_lua_http_ctx *http_ctx;
+
+  GET_HTTP_CONTEXT(http_ctx, L);
+
+  int count = TSHttpParentTableGetEntryCount(http_ctx->txnp);
+  lua_pushinteger(L, (lua_Integer)count);
+  return 1;
+}
diff --git a/src/api/InkAPI.cc b/src/api/InkAPI.cc
index 1d4d3c9d3..cf8f18750 100644
--- a/src/api/InkAPI.cc
+++ b/src/api/InkAPI.cc
@@ -9329,3 +9329,14 @@ TSLogAddrUnmarshal(char **buf, char *dest, int len)
 
   return {-1, -1};
 }
+
+/*
+ * Get entry count in parent.config.
+ */
+int
+TSHttpParentTableGetEntryCount(TSHttpTxn txnp)
+{
+  HttpSM              *sm = reinterpret_cast<HttpSM *>(txnp);
+  HttpTransact::State *s  = &(sm->t_state);
+  return s->parent_params && s->parent_params->parent_table ? s->parent_params->parent_table->getEntryCount() : 0;
+}
