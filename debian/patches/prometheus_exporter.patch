+struct prom_metric_info;
+using prom_histogram_handler = void (*)(stats_state *my_state, uint64_t v, const prom_metric_info &info);
+
+struct prom_metric_info {
+  const char            *prom_name;
+  const char            *type;
+  const char            *help;
+  const char            *histogram_name;
+  prom_histogram_handler histogram_handler;
+};
+
+static void
+text_prometheus_out_stat_histogram_head_bucket(stats_state *my_state, uint64_t v, const prom_metric_info &info)
+{
+  char b[256];
+
+  my_state->cumulative_count = v;
+  if (snprintf(b, sizeof(b), "# HELP %s %s\n# TYPE %s histogram\n%s %" PRIu64 "\n", info.histogram_name, info.help,
+               info.histogram_name, info.prom_name, my_state->cumulative_count) < (int)sizeof(b))
+    APPEND(b);
+}
+
+static void
+text_prometheus_out_stat_histogram_tail_bucket(stats_state *my_state, uint64_t v, const prom_metric_info &info)
+{
+  char b[256];
+
+  my_state->cumulative_count += v;
+  if (snprintf(b, sizeof(b), "%s %" PRIu64 "\n", info.prom_name, my_state->cumulative_count) < (int)sizeof(b))
+    APPEND(b);
+}
+
+static void
+text_prometheus_out_stat_histogram_sum_count(stats_state *my_state, uint64_t v, const prom_metric_info &info)
+{
+  char b[512];
+
+  if (snprintf(b, sizeof(b),
+               "%s_sum %" PRIu64 "\n"
+               "%s_count %" PRIu64 "\n",
+               info.prom_name, v, info.prom_name, my_state->cumulative_count) < (int)sizeof(b))
+    APPEND(b);
+}
