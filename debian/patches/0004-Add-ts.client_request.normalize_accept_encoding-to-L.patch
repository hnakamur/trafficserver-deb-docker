 void
 ts_lua_inject_client_request_api(lua_State *L)
 {
@@ -96,6 +99,7 @@ ts_lua_inject_client_request_api(lua_State *L)
   ts_lua_inject_client_request_ssl_cipher_api(L);
   ts_lua_inject_client_request_ssl_protocol_api(L);
